# .gitignore

# Python
*.pyc
__pycache__/
*.pyo
*.pyd
.Python
*.so
*.py[cod]
*$py.class

# Виртуальные окружения
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
ENV.bak/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Логи
*.log
*.pid
logs/
*.log.*

# Тесты и покрытие кода
.pytest_cache/
.coverage
htmlcov/
.coverage.*
.mypy_cache/
test_reports/
*.xml
*.json
reports/
allure-results/
allure-report/
.hypothesis/
.tox/

# Документация
docs/_build/
docs/_static/
docs/_templates/

# Пакеты
dist/
build/
*.egg-info/
*.egg
*.whl

# Docker
docker-compose.override.yml
.docker/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
test.env
*.env

# Allure
allure-results/
allure-report/

# Тестовые данные (если содержат чувствительную информацию)
# test_data/*.json
# test_data/*.yaml

# Временные файлы
*.tmp
*.temp
*.bak
*.swp
*~

# OS
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes